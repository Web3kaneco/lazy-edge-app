# Copy to .env (gitignored) for builds. Placeholders only; never commit real values.

# Required for sign in. The public Supabase anon key for Lazy Edge auth.
# Never the server's service role key.
MAIN_VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional overrides. Both must be https.
# MAIN_VITE_API_BASE=https://api.lazyedge.net
# MAIN_VITE_SUPABASE_URL=https://auth.lazyedge.net
